      "id": "c1a2b3d4-e5f6-4890-abcd-100000000005",
      "name": "Has Text Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 420]
    },
    {
      "parameters": {
        "jsCode": "// Extract message data from WhatsApp webhook payload\nconst entry = $input.first().json.body.entry[0];\nconst change = entry.changes[0].value;\nconst message = change.messages[0];\n\nconst messageText = message.text?.body || '';\nconst senderPhone = message.from;\nconst timestamp = new Date(parseInt(message.timestamp) * 1000).toISOString();\n\n// Check if there's an image in the same conversation context\nconst hasImage = message.type === 'image';\nconst imageId = message.image?.id || '';\n\nreturn {\n  json: {\n    messageText,\n    senderPhone,\n    timestamp,\n    hasImage,\n    imageId,\n    rawPayload: $input.first().json.body\n  }\n};"
      },
      "id": "c1a2b3d4-e5f6-4890-abcd-100000000006",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a1b2c3d4-0003",
              "leftValue": "={{ $json.senderPhone }}",
              "rightValue": "METS_TON_NUMERO_ICI",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1a2b3d4-e5f6-4890-abcd-100000000010",
      "name": "Is Allowed Number?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1230, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Tu es un assistant qui extrait des informations de rendez-vous a partir de messages WhatsApp. Extrais les informations suivantes du message ci-dessous et retourne UNIQUEMENT un JSON valide, sans texte autour :\\n\\n{\\n  \\\"client_name\\\": \\\"nom du client\\\",\\n  \\\"phone\\\": \\\"numero de telephone\\\",\\n  \\\"service\\\": \\\"type de service demande\\\",\\n  \\\"appointment_date\\\": \\\"date du rendez-vous au format YYYY-MM-DD\\\",\\n  \\\"appointment_time\\\": \\\"heure du rendez-vous au format HH:MM\\\"\\n}\\n\\nSi une information manque, mets une chaine vide. Pour la date, utilise la date la plus proche correspondant au jour mentionne. Aujourd'hui nous sommes le {{ $now.format('yyyy-MM-dd') }}.\\n\\nMessage WhatsApp :\\n{{ $json.messageText }}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c1a2b3d4-e5f6-4890-abcd-100000000007",
      "name": "Gemini Flash - Parse Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 360]
    },
    {
      "parameters": {
        "jsCode": "// Parse Gemini response\nconst geminiResponse = $input.first().json;\nconst extractedText = geminiResponse.candidates[0].content.parts[0].text;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(extractedText);\n} catch (e) {\n  const match = extractedText.match(/```json\\n?([\\s\\S]*?)\\n?```/);\n  if (match) {\n    parsed = JSON.parse(match[1]);\n  } else {\n    parsed = {\n      client_name: '',\n      phone: '',\n      service: '',\n      appointment_date: '',\n      appointment_time: ''\n    };\n  }\n}\n\nconst originalData = $('Extract Message Data').first().json;\n\nreturn {\n  json: {\n    date_received: originalData.timestamp,\n    client_name: parsed.client_name || '',\n    phone: parsed.phone || originalData.senderPhone || '',\n    service: parsed.service || '',\n    appointment_date: parsed.appointment_date || '',\n    appointment_time: parsed.appointment_time || '',\n    image_url: originalData.imageId ? 'WhatsApp Image ID: ' + originalData.imageId : '',\n    raw_message: originalData.messageText\n  }\n};"
      },
      "id": "c1a2b3d4-e5f6-4890-abcd-100000000008",
